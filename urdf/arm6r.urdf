<?xml version="1.0"?>
<!--
  6R 通用机械臂（本地演示 / 测试用，非任何真实型号）。
  关节轴交替布置、相邻轴不共线，零位雅可比满秩：
    joint_1  绕基座 z 轴（腰转）
    joint_2  绕 y 轴（肩俯仰），偏移 (0,0,0.3)
    joint_3  绕 z 轴（肩翻转），偏移 (0.05,0,0.4)
    joint_4  绕 y 轴（肘），偏移 (0.4,0,0)，origin rpy 绕 y +45deg
    joint_5  绕 z 轴（腕），偏移 (0,0,0.05)，origin rpy 绕 y -45deg
    joint_6  绕 y 轴（工具翻转），偏移 (0,0,0.08)
-->
<robot name="arm6r">
  <link name="base_link"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50" velocity="2"/>
  </joint>
  <link name="link_1"/>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.9" upper="1.9" effort="50" velocity="2"/>
  </joint>
  <link name="link_2"/>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.05 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.5" upper="2.5" effort="50" velocity="2"/>
  </joint>
  <link name="link_3"/>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.4 0 0" rpy="0 0.7853981633974483 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="3"/>
  </joint>
  <link name="link_4"/>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.05" rpy="0 -0.7853981633974483 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="20" velocity="3"/>
  </joint>
  <link name="link_5"/>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="end_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28318" upper="6.28318" effort="10" velocity="4"/>
  </joint>
  <link name="end_link"/>
</robot>
